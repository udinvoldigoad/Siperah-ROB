# SPA (index.html hasil build Vite) dan API Laravel disajikan dari docroot
# yang sama di Hostinger; index.html didahulukan, /api jatuh ke index.php.
DirectoryIndex index.html index.php

# Security headers untuk file statis (SPA). Respons API/PHP juga mendapat
# header dari middleware App\Http\Middleware\SecurityHeaders.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
    # Browser mengabaikan HSTS di koneksi HTTP biasa, aman dipasang global.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # CSP hanya untuk dokumen HTML (SPA). Origin eksternal yang dipakai:
    # Google Fonts (style+font), tile OSM (peta), Nominatim (geocoding),
    # Open-Meteo (cuaca), blob: (worker maplibre-gl), data: (ikon inline).
    # picsum.photos DIHAPUS dari img-src: placeholder-nya sudah dibuang dari
    # portal, jadi allowlist-nya tak punya alasan untuk tetap ada.
    <FilesMatch "\.html$">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.org; connect-src 'self' https://tile.openstreetmap.org https://nominatim.openstreetmap.org https://marine-api.open-meteo.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    </FilesMatch>

    # ── Cache ───────────────────────────────────────────────────────────
    # index.html adalah SATU-SATUNYA berkas yang menyebut nama bundle
    # /assets/*.js, dan namanya tak pernah berubah. Tanpa Cache-Control
    # browser menebak masa berlakunya sendiri dari Last-Modified, jadi
    # setelah deploy pengguna lama masih memuat index.html basi -> menunjuk
    # bundle versi lama -> fitur baru "tidak muncul" padahal sudah tayang.
    # Itu persis yang terjadi pada form OTP verifikasi email.
    <FilesMatch "\.html$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Sebaliknya, nama berkas aset build Vite mengandung hash isinya —
    # berubah isi berarti berubah nama, jadi aman disimpan selamanya.
    <FilesMatch "\.(js|css|woff|woff2)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # sw.js dikecualikan (blok ini HARUS setelah blok aset agar menang):
    # namanya tetap, dan service worker basi menahan perbaikan push.
    <FilesMatch "^sw\.js$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
