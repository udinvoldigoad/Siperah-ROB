APP_NAME=SIPERAH-RoB
APP_ENV=local
APP_KEY=
# Default aman untuk produksi. Setel true HANYA di mesin dev lokal —
# menyalin file ini apa adanya ke server tidak boleh membocorkan stack trace.
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=daily
LOG_MAX_FILES=14
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=siperah_rob
DB_USERNAME=postgres
DB_PASSWORD=

FILESYSTEM_DISK=local
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database
REDIS_CLIENT=predis
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
# Biarkan tetap dikomentari agar config/cors.php memakai default aman (APP_URL).
# Deployment satu-origin & dev via proxy Vite sama-sama tidak butuh CORS.
# Isi HANYA bila frontend dilayani dari origin lain (pisahkan dengan koma) —
# jangan pakai "*". Nilai kosong (`CORS_ALLOWED_ORIGINS=`) juga salah: itu
# menimpa default dengan daftar kosong, bukan mengembalikannya.
# CORS_ALLOWED_ORIGINS=https://siperah-rob.example.id
CORS_SUPPORTS_CREDENTIALS=false
