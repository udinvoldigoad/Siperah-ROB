APP_NAME=SAIBAR
APP_ENV=local
APP_KEY=
# Default aman untuk produksi. Setel true HANYA di mesin dev lokal â€”
# menyalin file ini apa adanya ke server tidak boleh membocorkan stack trace.
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=daily
LOG_MAX_FILES=14
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=saibar
DB_USERNAME=postgres
DB_PASSWORD=

FILESYSTEM_DISK=local
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database
REDIS_CLIENT=predis
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
# Biarkan tetap dikomentari agar config/cors.php memakai default aman (APP_URL).
# Deployment satu-origin & dev via proxy Vite sama-sama tidak butuh CORS.
# Isi HANYA bila frontend dilayani dari origin lain (pisahkan dengan koma) â€”
# jangan pakai "*". Nilai kosong (`CORS_ALLOWED_ORIGINS=`) juga salah: itu
# menimpa default dengan daftar kosong, bukan mengembalikannya.
# CORS_ALLOWED_ORIGINS=https://SAIBAR.example.id
CORS_SUPPORTS_CREDENTIALS=false

# â”€â”€ WebPush (notifikasi push browser) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Bangkitkan dengan: php artisan webpush:vapid
# KEDUANYA base64url TANPA padding â€” tidak boleh ada "+", "/", atau "=".
# Kunci publik 87-88 karakter (65 byte), privat 43-44 karakter (32 byte).
# Pastikan tiap variabel berada di BARISNYA SENDIRI: newline yang hilang
# pernah menyatukan VAPID_PRIVATE_KEY dengan VAPID_SUBJECT di produksi dan
# mematikan seluruh pengiriman push selama dua hari.
# `php artisan system:health-check` kini memeriksa bentuk ketiganya.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.test


